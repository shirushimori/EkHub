{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    { "src": "/api/tmdb/(.*)", "dest": "/api/tmdb.py" },
    { "src": "/api/scraper/(.*)", "dest": "/api/scraper.py" },
    { "src": "/api/hd4u/(.*)", "dest": "/api/hd4u.py" },
    { "src": "/api/hianime/(.*)", "dest": "/api/hianime.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
